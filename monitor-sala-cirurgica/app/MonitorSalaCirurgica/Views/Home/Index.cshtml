@model List<ResumoSalaViewModel>
@{
    ViewData["Title"] = "Início";
}
<div class="cabecalho">
    <div>
        <h1 class="h3 mb-1">Salas supervisionadas</h1>
        <p class="text-muted mb-0">Valores atuais vindos do Orion e alerta em vigor em cada sala. A supervisão automática confere as médias a cada 10 s.</p>
    </div>
    <a asp-controller="Sala" asp-action="Create" class="btn btn-success">Cadastrar sala</a>
</div>

<div class="row" id="statusServicos">
    @foreach (var nome in new[] { "IoT Agent", "Orion", "STH-Comet" })
    {
        <div class="col-md-4 mb-3">
            <div class="card status-servico" data-nome="@nome">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between"><strong>@nome</strong><span class="ponto"></span></div>
                    <div class="small text-muted" data-campo="detalhe">verificando…</div>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.Count == 0 && ViewBag.ErroFiware == null)
{
    <div class="card"><div class="card-body text-center text-muted py-5">Nenhuma sala cadastrada no IoT Agent ainda.</div></div>
}
<div class="row">
    @foreach (var r in Model)
    {
        string mostrado = r.Estado?.Alerta ?? "off";
        <div class="col-lg-6 mb-3">
            <div class="card h-100 cartao-sala alerta-@mostrado">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h2 class="h5 mb-0">@r.Nome</h2>
                            <div class="small text-muted"><code>@r.DeviceId</code> · perfil @r.Perfil</div>
                        </div>
                        <span class="chip alerta-@mostrado @(mostrado == "off" ? "normal" : "")">@(mostrado == "off" ? "normal" : "alerta " + mostrado)</span>
                    </div>
                    <div class="row text-center mt-3">
                        @foreach (var g in r.Grandezas)
                        {
                            <div class="col-4">
                                <div class="small text-muted">@g.Nome</div>
                                <div class="valor-pequeno @(g.EmAnomalia ? "text-danger" : "")">@(g.Atual.HasValue ? g.Atual.Value.ToString(g.Grandeza == "temperatura" ? "0.0" : "0") : "—")<small> @g.Unidade</small></div>
                            </div>
                        }
                    </div>
                    @if (r.AlertaCalculado != "off")
                    {
                        <div class="small text-danger mt-2">@r.Motivo</div>
                    }
                </div>
                <div class="card-footer bg-transparent">
                    <a asp-controller="Dashboard" asp-action="Index" asp-route-salaId="@r.DeviceId" class="btn btn-sm btn-primary">Abrir dashboard</a>
                    <a asp-controller="Mensagem" asp-action="ExibeConsultaAvancada" class="btn btn-sm btn-outline-secondary">Consultar mensagens</a>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>$(function () { exibeStatusServicos(); });</script>
}
