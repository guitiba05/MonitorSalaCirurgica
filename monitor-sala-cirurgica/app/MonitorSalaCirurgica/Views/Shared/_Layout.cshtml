@{
    string controllerAtual = ViewContext.RouteData.Values["controller"]?.ToString();
    string Ativo(string c) => string.Equals(controllerAtual, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var fiware = MonitorSalaCirurgica.DAO.HelperFiware.Config;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Monitor de Sala Cirúrgica</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("styles", false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark barra">
            <div class="container">
                <a class="navbar-brand marca" asp-controller="Home" asp-action="Index">
                    <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M10 3h4v7h7v4h-7v7h-4v-7H3v-4h7z" /></svg>
                    Monitor de Sala Cirúrgica
                </a>
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#menu"
                        aria-controls="menu" aria-expanded="false" aria-label="Abrir menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menu">
                    @if (ViewBag.Logado == true)
                    {
                        <ul class="navbar-nav mr-auto">
                            <li class="nav-item"><a class="nav-link @Ativo("Dashboard")" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link @Ativo("Sala")" asp-controller="Sala" asp-action="Index">Salas</a></li>
                            <li class="nav-item"><a class="nav-link @Ativo("Inscricao")" asp-controller="Inscricao" asp-action="Index">Inscrições</a></li>
                            <li class="nav-item"><a class="nav-link @Ativo("Mensagem")" asp-controller="Mensagem" asp-action="ExibeConsultaAvancada">Consulta IoT</a></li>
                            <li class="nav-item"><a class="nav-link @Ativo("Limite")" asp-controller="Limite" asp-action="Index">Limites</a></li>
                            <li class="nav-item"><a class="nav-link @Ativo("Alerta")" asp-controller="Alerta" asp-action="Index">Alertas</a></li>
                            <li class="nav-item"><a class="nav-link @Ativo("Alexa")" asp-controller="Alexa" asp-action="Index">Alexa</a></li>
                            <li class="nav-item"><a class="nav-link @Ativo("Conexao")" asp-controller="Conexao" asp-action="Index">Conexão</a></li>
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item"><a class="nav-link" asp-controller="Login" asp-action="LogOff">Sair</a></li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav ml-auto">
                            <li class="nav-item"><a class="nav-link" asp-controller="Login" asp-action="Index">Login</a></li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="py-4">
            @if (TempData["Mensagem"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">@TempData["Mensagem"]
                    <button type="button" class="close" data-dismiss="alert" aria-label="Fechar"><span aria-hidden="true">&times;</span></button></div>
            }
            @if (TempData["Aviso"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show">@TempData["Aviso"]
                    <button type="button" class="close" data-dismiss="alert" aria-label="Fechar"><span aria-hidden="true">&times;</span></button></div>
            }
            @if (TempData["Erro"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">@TempData["Erro"]
                    <button type="button" class="close" data-dismiss="alert" aria-label="Fechar"><span aria-hidden="true">&times;</span></button></div>
            }
            @if (ViewBag.ErroFiware != null)
            {
                <div class="alert alert-danger"><strong>FIWARE indisponível.</strong> @ViewBag.ErroFiware
                    <a asp-controller="Conexao" asp-action="Index" class="alert-link">Ver conexão</a></div>
            }
            @if (ViewBag.ErroBanco != null)
            {
                <div class="alert alert-warning"><strong>Banco de dados:</strong> @ViewBag.ErroBanco</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="rodape">
        <div class="container d-flex flex-wrap justify-content-between">
            <span>
                @if (ViewBag.Logado == true)
                {
                    <span id="pontoFiware" class="ponto" title="Situação do FIWARE"></span>
                }
                FIWARE:
                @if (fiware.Configurado)
                {
                    <strong>@fiware.HostLimpo</strong>
                    <span class="text-muted">· service <code>@fiware.Service</code> · servicepath <code>@fiware.ServicePath</code></span>
                }
                else
                {
                    <a asp-controller="Conexao" asp-action="Index">configure o IP da EC2</a>
                }
            </span>
            <span class="text-muted">Projeto N2 · Sistemas Embarcados e Linguagem de Programação I · FESA</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("bibliotecas", required: false)
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (ViewBag.Logado == true)
    {
        <script>$(function () { verificaStatusFiware(); });</script>
    }
    @RenderSection("Scripts", required: false)
</body>
</html>
